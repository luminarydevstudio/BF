	usernameLabel.TextSize = 12
	usernameLabel.TextColor3 = TEXT_SECONDARY
	usernameLabel.TextXAlignment = Enum.TextXAlignment.Center
	usernameLabel.TextYAlignment = Enum.TextYAlignment.Center
	usernameLabel.Text = "@" .. player.Name
	usernameLabel.LayoutOrder = 2
	usernameLabel.Parent = tag
	applyTextStroke(usernameLabel)

	local teamLabel = Instance.new("TextLabel")
	teamLabel.Name = "TeamName"
	teamLabel.BackgroundTransparency = 1
	teamLabel.Size = UDim2.new(1, 0, 0, 12)
	teamLabel.Font = Enum.Font.GothamMedium
	teamLabel.TextSize = 11
	teamLabel.TextColor3 = TEXT_SECONDARY
	teamLabel.TextXAlignment = Enum.TextXAlignment.Center
	teamLabel.TextYAlignment = Enum.TextYAlignment.Center
