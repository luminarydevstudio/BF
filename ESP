	return espButton, panel
end

local espButton, panel = createGUI()

local function updateButtonVisuals()
	local targetColor = ESP_ENABLED and ACCENT_ON or ACCENT_OFF
	local targetText = ESP_ENABLED and "ESP: ON" or "ESP: OFF"

	TweenService:Create(espButton, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		BackgroundColor3 = targetColor,
	}):Play()

	espButton.Text = targetText
end

espButton.MouseEnter:Connect(function()
	if ESP_ENABLED then
		return
	end
	TweenService:Create(espButton, TweenInfo.new(0.12), {
		BackgroundColor3 = Color3.fromRGB(68, 72, 84),
	}):Play()
end)

espButton.MouseLeave:Connect(function()
	if ESP_ENABLED then
		return
	end
	TweenService:Create(espButton, TweenInfo.new(0.12), {
		BackgroundColor3 = ACCENT_OFF,
	}):Play()
end)

espButton.Activated:Connect(function()
	setESPEnabled(not ESP_ENABLED)
	updateButtonVisuals()
end)

updateButtonVisuals()
