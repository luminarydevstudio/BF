local function createBodyHighlight(character: Model, player: Player): Highlight
	local colors = select(1, getTeamInfo(player))

	local highlight = Instance.new("Highlight")
	highlight.Name = "ESPBodyHighlight"
	highlight.Adornee = character
	highlight.FillColor = colors.fill
	highlight.OutlineColor = colors.outline
	highlight.FillTransparency = 0.45
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = character
	return highlight
end

local function disconnectAll(connections: { RBXScriptConnection })
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
end

local function destroyPlayerVisuals(data: any)
	if not data then
		return
	end

	if data.highlight and data.highlight.Parent then
		data.highlight:Destroy()
	end
	data.highlight = nil

	if data.tag and data.tag.Parent then
		data.tag:Destroy()
	end
	data.tag = nil
end

local function clearPlayerESP(player: Player)
	local data = trackedPlayers[player]
	if not data then
		return
	end

	disconnectAll(data.connections)
	destroyPlayerVisuals(data)
	trackedPlayers[player] = nil
end

local function getDistanceOpacity(distance: number): number
	if distance <= FADE_START_STUDS then
		return 1
	end
	if distance >= FADE_END_STUDS then
		return 0.35
	end
	local alpha = (distance - FADE_START_STUDS) / (FADE_END_STUDS - FADE_START_STUDS)
	return 1 - (alpha * 0.65)
end

local function getDistanceTextSize(distance: number): number
	local scale = math.clamp(1 - (distance / 500), 0.55, 1)
	return math.floor(MIN_TEXT_SIZE + (MAX_TEXT_SIZE - MIN_TEXT_SIZE) * scale + 0.5)
end

local function updatePlayerESP(player: Player)
	local data = trackedPlayers[player]
	if not data or not data.tag then
		return
	end

	local character = player.Character
	local tag = data.tag :: Frame
	local camera = getCamera()

	if not ESP_ENABLED or not camera or not isValidTarget(player, character) then
		tag.Visible = false
		if data.highlight then
			data.highlight.Enabled = false
		end
		return
	end

	local anchor = getHeadAnchor(character)
	if not anchor then
		tag.Visible = false
		return
	end

	local viewport, onScreen = camera:WorldToViewportPoint(anchor)
	if not onScreen or viewport.Z <= 0 then
		tag.Visible = false
		if data.highlight then
			data.highlight.Enabled = true
			data.highlight.Adornee = character
			applyTeamColors(player, data.highlight, tag)
		end
		return
	end

	local distance = (anchor - camera.CFrame.Position).Magnitude
	local opacity = getDistanceOpacity(distance)
	local textSize = getDistanceTextSize(distance)

	tag.Visible = true
	tag.Position = UDim2.fromOffset(viewport.X, viewport.Y)

	local displayNameLabel = tag:FindFirstChild("DisplayName") :: TextLabel?
	local usernameLabel = tag:FindFirstChild("Username") :: TextLabel?
	local distanceLabel = tag:FindFirstChild("Distance") :: TextLabel?

	if displayNameLabel then
		displayNameLabel.Text = player.DisplayName
		displayNameLabel.TextSize = textSize
		displayNameLabel.TextTransparency = 1 - opacity
		local stroke = displayNameLabel:FindFirstChild("Outline") :: UIStroke?
		if stroke then
			stroke.Transparency = 0.15 + (1 - opacity) * 0.85
		end
	end

	if usernameLabel then
		usernameLabel.Text = "@" .. player.Name
		usernameLabel.TextSize = math.max(MIN_TEXT_SIZE - 1, textSize - 2)
		usernameLabel.TextTransparency = 1 - opacity
		local stroke = usernameLabel:FindFirstChild("Outline") :: UIStroke?
		if stroke then
			stroke.Transparency = 0.15 + (1 - opacity) * 0.85
		end
	end

	if distanceLabel then
		distanceLabel.Text = formatDistance(distance)
		distanceLabel.TextSize = math.max(MIN_TEXT_SIZE - 1, textSize - 2)
		distanceLabel.TextTransparency = 1 - opacity
		local stroke = distanceLabel:FindFirstChild("Outline") :: UIStroke?
		if stroke then
			stroke.Transparency = 0.15 + (1 - opacity) * 0.85
		end
	end

	if data.highlight then
		data.highlight.Enabled = true
		data.highlight.Adornee = character
		applyTeamColors(player, data.highlight, tag)
	end
end

local function setupPlayerESP(player: Player)
	clearPlayerESP(player)

	if not ESP_ENABLED then
		return
	end

	local function onCharacterAdded(character: Model)
		local existing = trackedPlayers[player]
		if existing then
			destroyPlayerVisuals(existing)
		end

		if not ESP_ENABLED or not SCRIPT_ALIVE then
			return
		end

		task.defer(function()
			if not character.Parent or not isValidTarget(player, character) then
				return
			end

			local data = trackedPlayers[player]
			if not data then
				return
			end

			data.highlight = createBodyHighlight(character, player)
			data.tag = createScreenTag(player)

			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				table.insert(data.connections, humanoid.Died:Connect(function()
					if data.tag then
						data.tag.Visible = false
					end
					if data.highlight then
						data.highlight.Enabled = false
					end
				end))
			end

			updatePlayerESP(player)
		end)
	end

	local connections: { RBXScriptConnection } = {}
	table.insert(connections, player.CharacterAdded:Connect(onCharacterAdded))
	table.insert(connections, player:GetPropertyChangedSignal("DisplayName"):Connect(function()
		updatePlayerESP(player)
	end))
	table.insert(connections, player:GetPropertyChangedSignal("Team"):Connect(function()
		local data = trackedPlayers[player]
		if data then
			applyTeamColors(player, data.highlight, data.tag)
		end
		updatePlayerESP(player)
	end))

	trackedPlayers[player] = {
		highlight = nil,
		tag = nil,
		connections = connections,
	}

	if player.Character then
		onCharacterAdded(player.Character)
	end
end

local function refreshAllPlayers()
	for _, player in Players:GetPlayers() do
		setupPlayerESP(player)
	end
end

local function clearAllESP()
	for player in trackedPlayers do
		clearPlayerESP(player)
	end
	table.clear(trackedPlayers)
end

local function stopESPRuntime()
	if renderConnection then
		renderConnection:Disconnect()
		renderConnection = nil
	end
	if playerAddedConnection then
		playerAddedConnection:Disconnect()
		playerAddedConnection = nil
	end
	if playerRemovingConnection then
		playerRemovingConnection:Disconnect()
		playerRemovingConnection = nil
	end
end

local function startESPRuntime()
	stopESPRuntime()

	playerAddedConnection = Players.PlayerAdded:Connect(function(player)
		setupPlayerESP(player)
	end)

	playerRemovingConnection = Players.PlayerRemoving:Connect(function(player)
		clearPlayerESP(player)
	end)

	renderConnection = RunService.RenderStepped:Connect(function()
		for player in trackedPlayers do
			updatePlayerESP(player)
		end
	end)

	refreshAllPlayers()
end

local function setESPEnabled(enabled: boolean)
	if not SCRIPT_ALIVE or ESP_ENABLED == enabled then
		return
	end

	ESP_ENABLED = enabled

	if ESP_ENABLED then
		startESPRuntime()
	else
		stopESPRuntime()
		clearAllESP()
	end
end

local function createActionButton(parent: Instance, name: string, text: string, color: Color3, layoutOrder: number): TextButton
	local button = Instance.new("TextButton")
	button.Name = name
	button.LayoutOrder = layoutOrder
	button.Size = UDim2.new(1, 0, 0, 22)
	button.BackgroundColor3 = color
	button.BorderSizePixel = 0
	button.AutoButtonColor = false
	button.Font = Enum.Font.GothamBold
	button.TextSize = 12
	button.TextColor3 = TEXT_PRIMARY
	button.Text = text
	button.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = button

	return button
end

local function setPanelHidden(hidden: boolean)
	GUI_HIDDEN = hidden
	panel.Visible = not hidden
	restoreIcon.Visible = hidden
end

local function destroyScriptCompletely()
	if not SCRIPT_ALIVE then
		return
	end

	SCRIPT_ALIVE = false
	setESPEnabled(false)

	stopESPRuntime()

	if espOverlay and espOverlay.Parent then
		espOverlay:Destroy()
	end
	if screenGui and screenGui.Parent then
		screenGui:Destroy()
	end

	script:Destroy()
end

