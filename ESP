local espOverlay: ScreenGui
local panel: Frame
local restoreIcon: TextButton
local espButton: TextButton

local ACCENT_ON = Color3.fromRGB(0, 170, 255)
local ACCENT_OFF = Color3.fromRGB(55, 58, 68)
local ACCENT_DELETE = Color3.fromRGB(180, 55, 55)
local TEXT_PRIMARY = Color3.fromRGB(255, 255, 255)
local TEXT_SECONDARY = Color3.fromRGB(185, 195, 210)
local NO_TEAM_COLORS = {
	fill = Color3.fromRGB(140, 145, 155),
	outline = Color3.fromRGB(190, 195, 205),
	accent = Color3.fromRGB(170, 175, 185),
}

local teamPaletteCache: { [Team]: typeof(NO_TEAM_COLORS) } = {}

local MIN_TEXT_SIZE = 11
local MAX_TEXT_SIZE = 16
local FADE_START_STUDS = 350
local FADE_END_STUDS = 900

local function getCamera(): Camera?
	return workspace.CurrentCamera
end

local function getCharacterRoot(character: Model): BasePart?
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		return root
	end
	return character:FindFirstChild("Head") :: BasePart?
end

local function getHeadAnchor(character: Model): Vector3?
	local head = character:FindFirstChild("Head") :: BasePart?
	if head then
		return head.Position + Vector3.new(0, head.Size.Y * 0.5 + 0.35, 0)
	end

	local root = getCharacterRoot(character)
	if root then
		return root.Position + Vector3.new(0, 2.8, 0)
	end

	return nil
end

local function isValidTarget(player: Player, character: Model?): boolean
	if player == LocalPlayer or not character then
		return false
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = getCharacterRoot(character)
	if not humanoid or not root then
		return false
	end

	return humanoid.Health > 0
end

local function brighten(color: Color3, amount: number): Color3
	return Color3.new(
		math.clamp(color.R + amount, 0, 1),
		math.clamp(color.G + amount, 0, 1),
		math.clamp(color.B + amount, 0, 1)
	)
end

local function getTeamInfo(player: Player): (typeof(NO_TEAM_COLORS), string)
	local team = player.Team
	if not team then
		return NO_TEAM_COLORS, "No Team"
	end

	local cached = teamPaletteCache[team]
	if not cached then
		local base = team.TeamColor.Color
		cached = {
			fill = base,
			outline = brighten(base, 0.22),
			accent = brighten(base, 0.12),
		}
		teamPaletteCache[team] = cached
	end

	return cached, team.Name
end

local function applyTeamColors(player: Player, highlight: Highlight?, tag: Frame?)
	local colors, teamName = getTeamInfo(player)

	if highlight then
		highlight.FillColor = colors.fill
		highlight.OutlineColor = colors.outline
	end

	if tag then
		local teamLabel = tag:FindFirstChild("TeamName") :: TextLabel?
		local distanceLabel = tag:FindFirstChild("Distance") :: TextLabel?

		if teamLabel then
			teamLabel.Text = teamName
			teamLabel.TextColor3 = colors.accent
		end
		if distanceLabel then
			distanceLabel.TextColor3 = colors.outline
		end
	end
end

local function formatDistance(studs: number): string
	if studs >= 1000 then
		return string.format("%.1fkm", studs / 1000)
	end
	return string.format("%dm", math.floor(studs + 0.5))
end

local function applyTextStroke(label: TextLabel, thickness: number?)
	local stroke = Instance.new("UIStroke")
	stroke.Name = "Outline"
	stroke.Color = Color3.fromRGB(0, 0, 0)
	stroke.Thickness = thickness or 1.2
	stroke.Transparency = 0.15
	stroke.Parent = label
end

